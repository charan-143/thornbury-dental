# Neon Postgres connection string, pooled endpoint.
# Neon console > your project > Connection Details > "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# First administrator, used once by: node --env-file=.env.local scripts/seed.ts --admin-only
# Remove ADMIN_PASSWORD from the environment once the account exists.
ADMIN_EMAIL="you@yourpractice.example"
ADMIN_NAME="Your Name"
ADMIN_PASSWORD=""
