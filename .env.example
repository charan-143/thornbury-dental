# Neon Postgres connection string, pooled endpoint.
# Neon console > your project > Connection Details > "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Offline development only. Unset by default, and ignored in production.
#
# When Neon cannot be reached the application normally fails and says so. Set
# this to 1 and it will instead serve from a local PGlite database under .data/
# — a separate, empty copy of the records. Appointments booked and notes
# written against it are confirmed on screen and never reach Neon. Do not set
# it anywhere a real practice is using the system.
# ALLOW_LOCAL_DB_FALLBACK=1

# First administrator, used once by: node --env-file=.env.local scripts/seed.ts --admin-only
# Remove ADMIN_PASSWORD from the environment once the account exists.
ADMIN_EMAIL="you@yourpractice.example"
ADMIN_NAME="Your Name"
ADMIN_PASSWORD=""
